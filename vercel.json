{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/router.php" },
    { "source": "/:path*.php", "destination": "/api/router.php" }
  ]
}
